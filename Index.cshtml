@{
    ViewBag.Title = "ClimateGSR - Interactive Map";
}

<!--Leaflet CSS-->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    .game-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 20px;
    }

    #map {
        flex: 1 1 65%;
        height: 600px;
        background-color: #d4e6f1; /* ocean colour */
        border: 2px solid #2d6a4f;
        border-radius: 16px;
        box-shadow: 0 10px 25px -8px rgba(27, 67, 50, 0.25);
    }

    .stats-panel {
        flex: 1 1 30%;
        min-width: 280px;
        background: #ffffff;
        border: 1px solid rgba(82, 183, 136, 0.35);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 25px -8px rgba(27, 67, 50, 0.18);
    }

        .stats-panel h3 {
            margin-top: 0;
            border-bottom: 2px solid #52b788;
            color: #1b4332;
            padding-bottom: 10px;
        }

    .stat-item {
        margin: 15px 0;
        font-size: 1.1rem;
    }

    .stat-label {
        font-weight: bold;
        color: #2d6a4f;
    }

    .home-hero h1 {
        margin: 0 0 0.35rem;
        font-size: clamp(1.6rem, 4vw, 2rem);
        font-weight: 800;
    }

    .climate-section {
        margin: 2rem 0;
        color: #2d4a3e;
        line-height: 1.7;
    }

    .climate-section h2 {
        color: #1b4332;
        font-size: clamp(1.4rem, 3vw, 1.75rem);
        font-weight: 750;
        margin: 0 0 0.85rem;
    }

    .climate-eyebrow {
        color: #2d6a4f;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin: 0 0 0.5rem;
    }

    .climate-intro,
    .climate-awareness {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        align-items: center;
        gap: 2rem;
    }

    .climate-section p:last-child {
        margin-bottom: 0;
    }

    .climate-note {
        background: #f0f8f3;
        border-left: 4px solid #40916c;
        border-radius: 0 12px 12px 0;
        padding: 1.25rem;
    }

    .climate-note h3,
    .climate-impact h3 {
        color: #1b4332;
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 0.5rem;
    }

    .climate-impact-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .climate-impact {
        border-top: 3px solid #74c69d;
        background: #f5faf7;
        border-radius: 0 0 12px 12px;
        padding: 1.25rem;
    }

    .climate-awareness {
        background: #e8f5ed;
        border: 1px solid #b7e4c7;
        border-radius: 16px;
        padding: 1.75rem;
    }

    .climate-steps {
        margin: 0;
        padding-left: 1.3rem;
    }

    .climate-steps li {
        padding-left: 0.35rem;
        margin-bottom: 0.85rem;
    }

    .climate-steps li:last-child {
        margin-bottom: 0;
    }

    .climate-steps li::marker {
        color: #2d6a4f;
        font-weight: 700;
    }

    .climate-play-link {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.65rem 1.1rem;
        background: #1b4332;
        border: 2px solid #1b4332;
        border-radius: 8px;
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
    }

    .climate-play-link:hover {
        background: #2d6a4f;
        color: #ffffff;
    }

    .climate-section a:focus-visible {
        outline: 3px solid #1b4332;
        outline-offset: 4px;
    }

    .climate-sources {
        color: #465e53;
        font-size: 0.875rem;
        margin: -0.5rem 0 1.5rem;
        line-height: 1.7;
    }

    .climate-sources a {
        color: #245b43;
        text-underline-offset: 3px;
    }

    @@media (max-width: 767px) {
        .climate-intro,
        .climate-awareness,
        .climate-impact-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .climate-awareness {
            padding: 1.25rem;
        }
    }
</style>

<div class="container-fluid">
    <div class="home-hero">
        <h1>Climate Awareness Geo-Explorer</h1>
        <p>Hover over an outlined country and click to inspect its climate and demographic statistics.</p>
    </div>

    <section class="climate-section climate-intro" aria-labelledby="climate-explained-title">
        <div>
            <p class="climate-eyebrow">Understand the bigger picture</p>
            <h2 id="climate-explained-title">What is climate change?</h2>
            <p>Climate change is a lasting shift in Earth's temperatures and weather patterns. Today's warming is mainly driven by human activities, especially burning coal, oil and gas. This releases greenhouse gases such as carbon dioxide (CO<sub>2</sub>), which trap extra heat in the atmosphere.</p>
            <p>Cutting down forests adds to the problem by releasing stored carbon and reducing the number of trees that can absorb CO<sub>2</sub>. The effects reach far beyond warmer days.</p>
        </div>
        <aside class="climate-note" aria-labelledby="weather-climate-title">
            <h3 id="weather-climate-title">Weather or climate?</h3>
            <p>Weather is what happens today. Climate is the pattern over decades. A cold day can still happen in a warming world.</p>
        </aside>
    </section>

    <div class="game-container">
        <!--inteactive map container-->
        <div id="map"></div>

        <!--country stats display-->
        <div class="stats-panel">
            <h3 id="stat-country">Select a Country</h3>
            <div id="stat-content">
                <p class="text-muted">Click on any outlined country on the map to view its data.</p>
            </div>
        </div>
    </div>

    <section class="climate-section" aria-labelledby="climate-impacts-title">
        <p class="climate-eyebrow">A global issue. Everyday impacts.</p>
        <h2 id="climate-impacts-title">How is it affecting us?</h2>
        <div class="climate-impact-grid">
            <article class="climate-impact">
                <h3>Heat and health</h3>
                <p>More frequent and intense heatwaves put people's health at risk and make working, learning and staying safe outdoors harder.</p>
            </article>
            <article class="climate-impact">
                <h3>Water, food and homes</h3>
                <p>Heavier rainfall and worsening drought in many regions can damage homes, disrupt water supplies and reduce harvests, threatening livelihoods and food security.</p>
            </article>
            <article class="climate-impact">
                <h3>Coasts and wildlife</h3>
                <p>Rising seas increase coastal flooding, while warming oceans and changing habitats put wildlife and the communities that depend on nature under pressure.</p>
            </article>
        </div>
    </section>

    <section class="climate-section climate-awareness" aria-labelledby="climate-awareness-title">
        <div>
            <p class="climate-eyebrow">Explore. Question. Share.</p>
            <h2 id="climate-awareness-title">Climate Awareness Game</h2>
            <p>Climate change can feel distant until you connect it to real places. ClimateGSR brings country statistics into an interactive map and geography guessing game, turning unfamiliar numbers into something you can explore and remember.</p>
            <a class="climate-play-link" href="@Url.Action("Play", "Game")">Play the geography challenge <span aria-hidden="true">&rarr;</span></a>
        </div>
        <ol class="climate-steps">
            <li><strong>Explore a country.</strong> Click the map to discover its emissions, population and average temperature.</li>
            <li><strong>Compare thoughtfully.</strong> Look at both total emissions and emissions per person: they answer different questions.</li>
            <li><strong>Keep learning.</strong> Try the game, discuss what surprised you and explore the science behind the numbers.</li>
        </ol>
    </section>

    <p class="climate-sources">Learn more from the United Nations:
        <a href="https://www.un.org/en/climatechange/what-is-climate-change">What is climate change?</a>
        &middot; <a href="https://www.un.org/en/climatechange/causes-and-effects-climate-change">Causes and effects</a>.
    </p>
</div>

<!--leaflet js-->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // initialise leaflt.js map
        const map = L.map('map', {
            center: [20, 0],
            zoom: 1.5,
            minZoom: 1,
            zoomSnap: 0.25,
            zoomDelta: 0.5,
            maxBounds: [[-90, -180], [90, 180]]
        });

        //track currently selected country and json layer
        let selectedLayer = null;
        let climateDataMap = {};

        //common country names that might not match csv data and json outlines
        const nameAliases = {
            "United States of America": "United States",
            "Russian Federation": "Russia",
            "United Republic of Tanzania": "Tanzania",
            "Republic of Serbia": "Serbia",
            "Czechia": "Czech Republic",
            "Democratic Republic of the Congo": "DR Congo",
            "Korea, Republic of": "South Korea",
            "Iran (Islamic Republic of)": "Iran"
        };

        // define the default, hover, and selected styles for countries
        const defaultStyle = {
            color: "#2d6a4f",       //Outline colour
            weight: 1.5,            //Outline thickness
            fillColor: "#f1f8f4",   //Default unclicked fill
            fillOpacity: 0.7
        };

        const inactiveCountryStyle = {
            color: "#bdc3c7",
            weight: 0.5,
            fillColor: "#ecf0f1",
            fillOpacity: 0.3,
            interactive: false //Disable interaction for countries not in the CSV data
        };

        const hoverStyle = {
            color: "#2d6a4f",
            weight: 2,
            fillColor: "#95d5b2",   //Light green on hover
            fillOpacity: 0.85
        };

        const selectedStyle = {
            color: "#1b4332",
            weight: 2.5,
            fillColor: "#52b788",   //Remains green once clicked
            fillOpacity: 0.9
        };

        //helper function to retrieve country stats from the climateDataMap, considering aliases
        function getCountryStats(geoName) {
            if (!geoName) return null;
            const key = geoName.toLowerCase();
            if (climateDataMap[key]) return climateDataMap[key];

            const alias = nameAliases[geoName];
            if (alias && climateDataMap[alias.toLowerCase()]) {
                return climateDataMap[alias.toLowerCase()];
            }
            return null;
        }

        //fetch csv data from the server and then fetch the GeoJSON polygons for countries
        fetch('@Url.Action("GetClimateData", "Home")')
            .then(response => response.json())
            .then(data => {
                //store csv data in a map for quick access by country name
                data.forEach(item => {
                    if (item.Country)
                    {
                        climateDataMap[item.Country.trim().toLowerCase()] = item;
                    }
                });

                //fetch the GeoJSON data for countries from the GitHub repository
                return fetch('https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson');
            })
            .then(response => response.json())
            .then(geoData => {
                geoJsonLayer = L.geoJson(geoData, {
                    style: function (feature) {
                        const countryName = feature.properties.ADMIN || feature.properties.name;
                        const hasData = getCountryStats(countryName) !== null;
                        //only outline countries that are within the csv data, others are greyed out
                        return hasData ? defaultStyle : inactiveCountryStyle;
                    },
                    onEachFeature: function (feature, layer) {
                        const countryName = feature.properties.ADMIN || feature.properties.name;
                        const countryStats = getCountryStats(countryName);

                        //only attach hover and click events to countries in the CSV files
                        if (countryStats) {
                            // Track selection state directly on the layer instance
                            layer.isSelected = false;

                            layer.on('mouseover', function () {
                                if (!layer.isSelected) {
                                    layer.setStyle(hoverStyle);
                                }
                            });

                            layer.on('mouseout', function () {
                                if (!layer.isSelected) {
                                    layer.setStyle(defaultStyle);
                                }
                            });

                            layer.on('click', function () {
                                // 1. If a previous country was selected, unselect it and reset its colour
                                if (selectedLayer && selectedLayer !== layer) {
                                    selectedLayer.isSelected = false;
                                    selectedLayer.setStyle(defaultStyle);
                                }

                                // 2. Mark the clicked country as selected and colour it green
                                layer.isSelected = true;
                                selectedLayer = layer;
                                layer.setStyle(selectedStyle);

                                // 3. Update the stats panel
                                updateStatsPanel(countryStats);
                            });
                        }
                    }
                }).addTo(map);
            })
            .catch(err => console.error("Error loading map or climate data:", err));

        //update the UI with the selected country's CSV stats
        function updateStatsPanel(stats) {
            const countryHeader = document.getElementById("stat-country");
            const contentBox = document.getElementById("stat-content");

            if (countryHeader && contentBox) {
                countryHeader.innerText = stats.Country;
                contentBox.innerHTML = `
                    <div class="stat-item">
                        <span class="stat-label">Annual CO₂ Emissions:</span><br/>
                        <span>${stats.CO2}</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">CO₂ Per Capita:</span><br/>
                        <span>${stats.CO2PerCapita}</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Population:</span><br/>
                        <span>${stats.Population}</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Average Temperature:</span><br/>
                        <span>${stats.Temperature}</span>
                    </div>
                `;
            }
        }
    });
</script>
